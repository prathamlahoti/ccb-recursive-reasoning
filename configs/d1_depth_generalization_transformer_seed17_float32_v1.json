{
  "domain": "d1",
  "models": ["ccb_token_transformer"],
  "seeds": [17],
  "output_directory": "/kaggle/working/d1-depth-generalization-v1/transformer",
  "width": 512,
  "layers_or_loops": 2,
  "steps": 10000,
  "batch_size": 8,
  "evaluation_batch_size": 8,
  "learning_rate": 0.0001,
  "weight_decay": 0.1,
  "loop_supervision_weight": 0.0,
  "include_official_evaluation": false,
  "bootstrap_resamples": 2000,
  "device": "cuda",
  "checkpoint_interval_steps": 250,
  "ema_decay": 0.999,
  "trm_h_cycles": 3,
  "trm_l_cycles": 6,
  "trm_max_depth": 50,
  "trm_halt_max_steps": 16,
  "trm_halt_exploration_prob": 0.1,
  "optimizer": "adam_atan2",
  "optimizer_betas": [0.9, 0.95],
  "lr_warmup_steps": 2000,
  "lr_min_ratio": 1.0,
  "official_trm_forward_dtype": "float32",
  "evaluation_splits": ["validation", "test_depth"],
  "evaluation_weights": "ema",
  "record_live_evaluation": true
}
